@model List<Lab_6.Models.Product>

<!DOCTYPE html>
<html>
<head>
    <title>Product Catalog</title>
</head>
<body>
    <h1>Product Catalog</h1>
    <table border="1">
        <tr>
            <th>Name</th>
            <th>ID</th>
            <th>Url</th>
        </tr>
        @foreach (var data in Model)
        {
            <tr>
                <td>@data.PName</td>
                <td>@data.PId</td>
                <td>
                    <a href="@Url.Action("Details", "Product", new { id = data.PId })">View Details</a>
                </td>
            </tr>
        }
    </table>
</body>
</html>
